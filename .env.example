# TAB@Work (tab-4-good) — environment variables.
# Copy to .env.local for local dev, and set the same keys in Vercel:
# Project → Settings → Environment Variables. None are committed.
# The app degrades gracefully: each feature turns on only when its keys are present.

# ── AI pilot-brief generator (src/server/pilot-brief.functions.ts) ──
# Vercel AI Gateway credential. On Vercel with OIDC enabled, the function
# already uses the request's x-vercel-oidc-token automatically — set this only
# for local dev or if OIDC is off. Without a credential the generator returns
# "temporarily unavailable" instead of failing the build.
AI_GATEWAY_API_KEY=

# ── Secure contact-request storage (src/server/leads.functions.ts) ──
# Vercel Blob read-write token. Stores each Design-Partner/Investor request as
# a private JSON object under contact-requests/<date>/<id>.json.
# Create it in Vercel: Storage → Blob → connect to this project.
BLOB_READ_WRITE_TOKEN=

# ── Email notification on new contact requests (Resend) ──
# When set, every submitted request is emailed to danya@dynamicbridge.io.
RESEND_API_KEY=
# Optional from-address (must be a verified Resend sender/domain).
# Defaults to: TAB@Work <leads@dynamicbridge.io>
CONTACT_FROM_EMAIL=
