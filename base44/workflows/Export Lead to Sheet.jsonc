{
  "name": "Export Lead to Sheet",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "export_lead_to_sheet",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "export_lead": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "exportLeadToSheet",
            "args": {
              "lead_id": "${ .trigger.data.id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Export lead to Google Sheet",
            "description": "Append the new lead as a row"
          }
        }
      }
    ]
  },
  "description": "Appends every new lead form submission to a Google Sheet for real-time tracking of investor and partner interest. Passes only the lead id; the function verifies the lead exists before exporting.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  }
}