{
  "name": "Lead",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Design Partner",
        "Investor"
      ],
      "title": "Lead Type"
    },
    "name": {
      "type": "string",
      "title": "Name"
    },
    "company": {
      "type": "string",
      "title": "Company"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "note": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "type",
    "name",
    "email"
  ],
  "rls": {
    "create": null,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}